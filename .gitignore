# ============================================================
# AI Strategy Arena — .gitignore
# ============================================================

# Environment variables and API keys (NEVER commit these!)
.env
.env.*
!.env.example
*.env

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor configs
.vscode/
.idea/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Game decision logs & runtime data (auto-generated, can be large)
logs/
*.jsonl
*.log

# Local scratch & runtime data
scratch/

# Wesnoth local installation (too large, user installs separately)
Wesnoth1.18/

# Temp files
help.txt
*.tmp
*.bak

# Wesnoth map files in wesnoth local install path (keep bridge copies)
wesnoth/data/
